NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: a short external feedback form for the public probe cohort.
NEXT_PUBLIC_FEEDBACK_URL=

# Server-only. Required only when running npm run seed:pipeline locally.
SUPABASE_SECRET_KEY=

# Server-only review administration. Keep these out of client bundles.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
